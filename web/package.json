{
  "name": "ciapol-web",
  "version": "2.0.0",
  "private": true,
  "description": "Refonte du site du Centre Ivoirien Antipollution (CIAPOL) — Next.js + React",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "postbuild": "node scripts/flatten-segments.mjs",
    "start": "npx serve@14 out -l 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run deadcode && npm run build && npm test",
    "deadcode": "knip"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.1",
    "lenis": "^1.3.28",
    "lucide-react": "^1.79.0",
    "marked": "^15.0.12",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "knip": "^5.88.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
